# ============================================================
# RF-WorldPose — Credentials & Config (single source of truth)
# ============================================================
# Copy thành .env rồi chỉnh: cp .env.example .env
# Tất cả services đọc từ file này.
# ============================================================

RFPOSE_ENV=dev

# --- PostgreSQL ---
POSTGRES_USER=rfpose
POSTGRES_PASSWORD=rfpose
POSTGRES_DB=rfpose

# --- MinIO (S3-compatible storage) ---
S3_ENDPOINT_URL=http://207.180.243.242:9000
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=rfpose

# --- NATS ---
NATS_URL=nats://nats:4222

# --- Helios HPC (đổi khi có account thật) ---
HELIOS_LOGIN=login01.helios.cyfronet.pl
HELIOS_ACCOUNT=CHANGE_ME-gpu-gh200
HELIOS_PARTITION=plgrid-gpu-gh200
