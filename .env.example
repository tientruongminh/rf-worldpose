# ============================================================
# RF-WorldPose — Credentials & Config (single source of truth)
# ============================================================
# Copy thành .env rồi chỉnh: cp .env.example .env
# Tất cả services đọc từ file này.
# ============================================================

RFPOSE_ENV=dev

# --- PostgreSQL ---
POSTGRES_USER=rfpose
POSTGRES_PASSWORD=rfpose
POSTGRES_DB=rfpose

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=rfpose
MINIO_ROOT_PASSWORD=rfpose-secret
S3_BUCKET=rfpose

# --- NATS ---
NATS_URL=nats://nats:4222

# --- HPC (Eagle PCSS) ---
HPC_LOGIN=eagle.man.poznan.pl
HPC_USER=tiencd1234
HPC_SSH_KEY=/opt/rfpose/.ssh/helios_ed25519
HPC_ACCOUNT=
HPC_PARTITION=
HPC_WORK_DIR=~/pl0501-01/project_data/tien

# --- S3 + MLflow (dùng IP công khai để HPC compute nodes truy cập) ---
S3_ENDPOINT_URL=http://207.180.243.242:9000
MLFLOW_TRACKING_URI=http://207.180.243.242:5000
